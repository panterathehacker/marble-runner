{
  "name": "marble-runner",
  "version": "0.1.0",
  "description": "Walk around any Marble world in 60 seconds. Built for Claude Code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "world:add": "node --import tsx/esm scripts/world-add.ts",
    "world:gen": "node --import tsx/esm scripts/world-gen.ts",
    "world:list": "node --import tsx/esm scripts/world-list.ts",
    "character:list": "node --import tsx/esm scripts/character-list.ts",
    "character:combine": "node --import tsx/esm scripts/combine-mixamo.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@sparkjsdev/spark": "github:sparkjsdev/spark#v2.0.0-preview",
    "lil-gui": "^0.21.0",
    "postprocessing": "6.39.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/three": "^0.183.0",
    "dotenv": "17.4.2",
    "fbx2gltf": "^0.9.7-p1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.0.1",
    "vite-plugin-top-level-await": "^1.4.4"
