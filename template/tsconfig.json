{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "paths": {
      "marble-runner": ["./src/types.ts"]
    }
  },
  "include": ["src", "scripts", "marble.config.ts"]
}
